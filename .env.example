# Used by docker-compose.yml. Copy to .env and change every value.
DB_USERNAME=artbazaar
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Signing key for access tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# First admin account, created on startup if it does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin1
